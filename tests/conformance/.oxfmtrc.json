{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "sortImports": {
    "newlinesBetween": true
  },
  "ignorePatterns": ["node_modules/", "dist/", "build/", "coverage/", "*.md"]
}
