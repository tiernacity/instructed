{
  "name": "instructed-conformance",
  "version": "0.0.0",
  "private": true,
  "description": "SQL-only conformance harness for the instructed contract (Phase 9, D-0021).",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 'test/*.test.ts'",
    "test:watch": "node --test --test-concurrency=1 --watch 'test/*.test.ts'",
    "coverage": "node coverage-report.ts",
    "format:check": "npx oxfmt --check .",
    "format:fix": "npx oxfmt --write .",
    "lint:check": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "ci": "npm run format:check && npm run lint:check && npm run test"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
