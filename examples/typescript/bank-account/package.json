{
  "name": "bank-account-example",
  "private": true,
  "description": "Bank-account example for the instructed TS SDK. Demonstrates aggregates, projections, and a process manager, each runnable in its own foreground process.",
  "type": "module",
  "scripts": {
    "db": "node --conditions=development scripts/db.ts",
    "workers": "node --conditions=development scripts/workers.ts",
    "monitor": "node --conditions=development scripts/monitor.ts",
    "open-account": "node --conditions=development scripts/open-account.ts",
    "deposit": "node --conditions=development scripts/deposit.ts",
    "transfer": "node --conditions=development scripts/transfer.ts",
    "type-check": "tsc --noEmit",
    "format:check": "npx oxfmt --check .",
    "format:fix": "npx oxfmt --write .",
    "lint:check": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "ci": "npm run format:check && npm run lint:check"
  },
  "dependencies": {
    "instructed-sdk": "file:../../../sdks/typescript",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
