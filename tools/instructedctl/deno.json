{
  "name": "instructedctl",
  "version": "0.0.0",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run -A src/main.ts",
    "check": "deno check src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "compile": "deno compile -A --output instructedctl src/main.ts",
    "test": "deno test -A"
  },
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/assert": "jsr:@std/assert@^1.0.0"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 88,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  }
}
