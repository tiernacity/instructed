{
  "name": "instructed-sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for instructed — CQRS/ES on Postgres",
  "keywords": [
    "commanded",
    "cqrs",
    "event-sourcing",
    "instructed",
    "postgresql"
  ],
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./core": {
      "development": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/cjs/core.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'test/*.test.ts'",
    "test:watch": "node --test --test-concurrency=1 --watch 'test/*.test.ts'",
    "format:check": "npx oxfmt --check .",
    "format:fix": "npx oxfmt --write .",
    "lint:check": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "ci": "npm run format:check && npm run lint:check && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "pg": "^8.13.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
