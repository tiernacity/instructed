{
  "name": "instructed-sdk",
  "version": "0.0.0",
  "description": "TypeScript SDK for instructed — CQRS/ES on Postgres",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "type-check": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'test/*.test.ts'",
    "test:watch": "node --test --test-concurrency=1 --watch 'test/*.test.ts'"
  },
  "keywords": [
    "instructed",
    "cqrs",
    "event-sourcing",
    "postgresql",
    "commanded"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "pg": "^8.13.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
